# ConstructGuard AI — Environment Variables

# Mode: "mock" for local dev (no GPU), "production" for AMD Cloud
INFERENCE_MODE=mock

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Model (production only)
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
DEVICE=cuda
TORCH_DTYPE=float16

# Roboflow (optional — for test images)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Site defaults
DEFAULT_SITE_ID=site_001
